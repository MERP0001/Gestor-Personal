{
  "name": "gestor-personal",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @gestor-personal/mobile",
    "server": "yarn workspace @gestor-personal/server",
    "dev": "concurrently \"yarn mobile start\" \"yarn server start:dev\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "turbo": "^1.12.3",
    "typescript": "^5.0.0"
  }
} 